    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dompurify": "3.4.0",
    "es-toolkit": "1.40.0",
    "lucide-react": "0.563.0",
    "react-hotkeys-hook": "4.6.1",
