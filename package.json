{
  "name": "@blakaa/kinkin-editor",
  "version": "0.6.0",
  "description": "A drop-in rich text editor for React - a Notion-style WYSIWYG built on Tiptap, with slash commands, tables, images, markdown I/O and streaming AI Assist.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./content": {
      "types": "./dist/content.d.ts",
      "import": "./dist/content.js"
    },
    "./style.css": "./dist/style.css",
    "./content.css": "./dist/content.css",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blakaalab/kinkin-editor.git"
  },
  "homepage": "https://github.com/blakaalab/kinkin-editor#readme",
  "bugs": {
    "url": "https://github.com/blakaalab/kinkin-editor/issues"
  },
  "keywords": [
    "rich-text-editor",
    "react-rich-text-editor",
    "wysiwyg",
    "wysiwyg-editor",
    "react",
    "react-editor",
    "tiptap",
    "tiptap-react",
    "prosemirror",
    "markdown",
    "markdown-editor",
    "block-editor",
    "notion",
    "notion-like",
    "slash-commands",
    "text-editor",
    "editor",
    "ai",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build:playground": "vite build",
    "build": "tsc --noEmit && vite build --mode lib && node scripts/build-content-css.mjs",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "check": "biome check",
    "check:fix": "biome check --fix",
    "knip": "knip",
    "lint": "biome lint",
    "format": "biome format --write",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@tiptap/core": "~3.31.3",
    "@tiptap/extension-drag-handle-react": "~3.31.3",
    "@tiptap/extension-emoji": "~3.31.3",
