    "@tiptap/react": "~3.31.3",
    "@tiptap/starter-kit": "~3.31.3",
    "@tiptap/suggestion": "~3.31.3",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@ariakit/react": "0.4.15",
